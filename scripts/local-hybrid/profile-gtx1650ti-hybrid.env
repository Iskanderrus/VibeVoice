# Profile: GTX 1650 Ti (4 GiB) hybrid generation.
# CUDA: tokenizers, connectors, prediction head. CPU fp32: language model.
# Every value below is a parameter; change it here, not in the code.
VIBEVOICE_SOURCE_REPOSITORY=Iskanderrus/VibeVoice
VIBEVOICE_SOURCE_REVISION=113af8074dcc7828835a6158ea0a72dfec8015df
VIBEVOICE_MODEL_REPOSITORY=vibevoice/VibeVoice-1.5B
VIBEVOICE_MODEL_REVISION=d374386b2a51d8e05277a64d85b296c89ec52376
VIBEVOICE_TOKENIZER_REVISION=8faed761d45a263340a0528343f099c05c9a4323
VIBEVOICE_LOCAL_FILES_ONLY=true
VIBEVOICE_REQUIRE_MODEL_MANIFEST=true
VIBEVOICE_DEVICE=cuda
VIBEVOICE_DTYPE=float16
VIBEVOICE_LANGUAGE_MODEL_DEVICE=cpu
VIBEVOICE_CPU_MAX_MEMORY_GB=24
VIBEVOICE_GENERATION_TIMEOUT_SECONDS=3600
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Thermal guard (scripts/local-hybrid/thermal_guard.sh)
THERMAL_GPU_PAUSE_C=80
THERMAL_CPU_PAUSE_C=88
THERMAL_GPU_RESUME_C=68
THERMAL_CPU_RESUME_C=78
# Machine paths (default layout; override in a copy of this file if needed)
VIBEVOICE_MODEL_PATH=$HOME/.local/share/stickman-vibevoice/models/VibeVoice-1.5B
VIBEVOICE_MODEL_MANIFEST=$HOME/.local/share/stickman-vibevoice/models/VibeVoice-1.5B/.stickman-model.json
VIBEVOICE_OFFLOAD_DIR=$HOME/.local/share/stickman-vibevoice/offload
VIBEVOICE_OUTPUT_DIR=$HOME/.local/share/stickman-vibevoice/output
VIBEVOICE_REFERENCE_DIR=$HOME/.local/share/stickman-vibevoice/references-8s
VIBEVOICE_SOURCE_REVISION_FILE=$HOME/.local/share/stickman-vibevoice/no-image-revision-file
HF_HOME=$HOME/.local/share/stickman-vibevoice/models/VibeVoice-1.5B/.hf-cache
HF_HUB_OFFLINE=1
