# The source revision is computed from the clean Iskanderrus/VibeVoice checkout by
# scripts/build_stickman_service.sh. Do not set it manually for governed builds.

# Exact 40-character Hugging Face commit SHA used to download VibeVoice-1.5B.
VIBEVOICE_MODEL_REVISION=0000000000000000000000000000000000000000

# Exact 40-character commit SHA for the Qwen/Qwen2.5-1.5B tokenizer snapshot
# cached inside the local model bundle.
VIBEVOICE_TOKENIZER_REVISION=0000000000000000000000000000000000000000

# Absolute host paths.
VIBEVOICE_MODEL_HOST_DIR=/absolute/path/to/VibeVoice-1.5B
VIBEVOICE_REFERENCE_HOST_DIR=/absolute/path/to/approved-voice-references
VIBEVOICE_OUTPUT_HOST_DIR=/absolute/path/to/generated-audio

# Target-laptop defaults (GTX 1650 Ti 4 GB + system RAM offload).
VIBEVOICE_DEVICE=auto
VIBEVOICE_DTYPE=auto
VIBEVOICE_CPU_OFFLOAD=true
VIBEVOICE_CUDA_MAX_MEMORY_MB=3400
VIBEVOICE_CPU_MAX_MEMORY_GB=24
VIBEVOICE_IDLE_UNLOAD_SECONDS=300
VIBEVOICE_GENERATION_TIMEOUT_SECONDS=1800
VIBEVOICE_CLEANUP_TIMEOUT_SECONDS=30
VIBEVOICE_REFERENCE_MAX_BYTES=52428800
VIBEVOICE_REFERENCE_MAX_SECONDS=120
